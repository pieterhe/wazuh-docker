# ── TLS snippet reused across all sites ──────────────────────
(zeroed_nl_tls) {
	tls /certs/zeroed_nl/fullchain.pem /certs/zeroed_nl/privkey.pem
}

# ── No-tenant proxy snippet ───────────────────────────────────
(wazuh_proxy) {
	reverse_proxy wazuh.dashboard:5601 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
		header_up Host wazuh.dashboard
	}
}

# ── Admin access — no tenant override ────────────────────────
admin.zeroed.nl {
	import zeroed_nl_tls
	import wazuh_proxy
}

# ── Direct host access — no tenant override ───────────────────
tuxido.zeroed.nl {
	import zeroed_nl_tls
	import wazuh_proxy
}

# ── Tenant access — inject securitytenant header ──────────────
*.zeroed.nl {
	import zeroed_nl_tls

	reverse_proxy wazuh.dashboard:5601 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
		header_up Host wazuh.dashboard
		header_up securitytenant tenant_{labels.2}
	}
}
