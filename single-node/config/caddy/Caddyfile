(zeroed_nl_tls) {
	tls /certs/zeroed_nl/fullchain.pem /certs/zeroed_nl/privkey.pem
}

(wazuh_proxy) {
	reverse_proxy wazuh.dashboard:5601 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
		header_up Host wazuh.dashboard
	}
}

admin.zeroed.nl {
	import zeroed_nl_tls
	import wazuh_proxy
}

tuxido.zeroed.nl {
	import zeroed_nl_tls
	import wazuh_proxy
}

*.zeroed.nl {
	import zeroed_nl_tls

	# PowerShell UA → serve .ps1 file
	@ps1ua {
		path /register/*
		header_regexp User-Agent PowerShell
	}
	handle @ps1ua {
		root * /register/{labels.2}
		uri strip_prefix /register
		rewrite * {path}.ps1
		file_server
	}

	# All other clients → serve shell script
	handle /register/* {
		root * /register/{labels.2}
		uri strip_prefix /register
		file_server
	}

	reverse_proxy wazuh.dashboard:5601 {
		transport http {
			tls
			tls_insecure_skip_verify
		}
		header_up Host wazuh.dashboard
		header_up securitytenant tenant_{labels.2}
	}
}
