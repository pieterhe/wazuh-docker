<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="101010" level="10">
    <match>WAZUH_TEST</match>
    <description>Test Active Response</description>
  </rule>

  <rule id="100500" level="10">
    <if_sid>60003</if_sid>
    <field name="win.system.providerName">^ITSecG-Isolation$</field>
    <field name="win.system.eventID">^901$</field>
    <description>ITsecG: Endpoint $(win.system.computer) is geïsoleerd</description>
    <group>itsecg_isolation,endpoint_isolated,</group>
  </rule>

  <rule id="100501" level="10">
    <if_sid>60003</if_sid>
    <field name="win.system.providerName">^ITSecG-Isolation$</field>
    <field name="win.system.eventID">^902$</field>
    <description>ITsecG: Endpoint $(win.system.computer) is vrijgegeven</description>
    <group>itsecg_isolation,endpoint_released,</group>
  </rule>

</group>
